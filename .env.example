# Public site URL — used for canonical links, Open Graph URLs and sitemap.xml
VITE_SITE_URL=https://www.ajumogobiaokeke.com

# Contact form endpoint (POST, JSON). Leave empty until an approved backend /
# email service (e.g. Formspree, a serverless function, or the firm's own API) is configured.
# While empty, the form validates but tells the visitor that online sending is not yet
# enabled and offers a direct email link — it never pretends a message was sent.
VITE_CONTACT_ENDPOINT=

# Newsletter subscription endpoint (POST, JSON: { email }). e.g. Mailchimp / Brevo proxy.
VITE_NEWSLETTER_ENDPOINT=

# Alumni network registration endpoint (POST, JSON).
VITE_ALUMNI_ENDPOINT=

# Show "Awaiting confirmation" markers for content the Firm must verify.
# Keep true for client review; set to false for the public launch build.
VITE_SHOW_REVIEW_NOTES=true
